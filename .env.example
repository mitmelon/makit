PORT=3000
NODE_ENV=development

# Data store
DB_DRIVER=memory
MONGO_URL=
MONGO_DB_NAME=makit

# Auth
JWT_SECRET=
JWT_TTL=30d

# Encrypts stored provider API keys at rest — REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Email notifications (optional per-task)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Makit <no-reply@makit.app>

SCHEDULER_CRON=* * * * *
