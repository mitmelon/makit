<%- include('partials/header', { title: 'Settings — Makit' }) %>
    <main class="flex-1 px-6 lg:px-10 py-8 max-w-2xl space-y-8">
        <p class="text-[14px] text-ink-soft -mt-4">Manage the AI provider and search keys your Intelligence can use.</p>

        <section class="panel p-6">
            <h2 class="text-[15px] font-semibold text-ink mb-4">Your keys</h2>
            <div id="key-list" class="space-y-2 mb-6"></div>

            <form id="key-form" class="space-y-4 pt-4 border-t border-line">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="field-label" for="provider">Provider</label>
                        <select class="field-input" id="provider">
                            <option value="bedrock">Amazon Bedrock</option>
                            <option value="gemini">Google Gemini</option>
                            <option value="parallel">Parallel (web search)</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label" for="label">Label</label>
                        <input class="field-input" id="label" placeholder="My AWS account" required />
                    </div>
                </div>

                <div id="bedrock-fields" class="space-y-4">
                    <div>
                        <label class="field-label" for="bedrock-region">Region</label>
                        <select class="field-input" id="bedrock-region"></select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="field-label" for="bedrock-access-key">Access key ID <span
                                    class="text-ink-faint font-normal">(optional)</span></label>
                            <input class="field-input" id="bedrock-access-key" placeholder="AKIA..."
                                autocomplete="off" />
                        </div>
                        <div>
                            <label class="field-label" for="bedrock-secret-key">Secret access key <span
                                    class="text-ink-faint font-normal">(optional)</span></label>
                            <input class="field-input" id="bedrock-secret-key" type="password"
                                placeholder="Leave both blank to use server AWS credentials" autocomplete="off" />
                        </div>
                    </div>
                    <p class="field-hint">Leave the access key and secret blank to have this server use its own AWS
                        credentials instead — useful when Makit itself is deployed with an IAM role.</p>
                </div>

                <div id="single-key-fields" class="hidden">
                    <label class="field-label" for="single-key" id="single-key-label">API key</label>
                    <input class="field-input" id="single-key" type="password" placeholder="Your API key"
                        autocomplete="off" />
                </div>

                <p id="error" class="text-[13px] text-[#c62b21] hidden"></p>
                <button type="submit" class="btn-secondary">Add key</button>
            </form>
        </section>

        <section class="panel p-6">
            <h2 class="text-[15px] font-semibold text-ink mb-1">MCP servers</h2>
            <p class="text-[13px] text-ink-soft mb-4">Give your Intelligence extra powers by connecting your own MCP
                server — a WhatsApp MCP for notifications, or anything else that exposes tools. Attach one to a specific
                Intelligence when you create or edit it.</p>
            <div id="mcp-list" class="space-y-2 mb-6"></div>

            <form id="mcp-form" class="space-y-4 pt-4 border-t border-line">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="field-label" for="mcp-label">Label</label>
                        <input class="field-input" id="mcp-label" placeholder="WhatsApp MCP" required />
                    </div>
                    <div>
                        <label class="field-label" for="mcp-url">Server URL</label>
                        <input class="field-input" id="mcp-url" type="url" placeholder="https://your-mcp-server.com/mcp"
                            required />
                    </div>
                </div>
                <div>
                    <label class="field-label" for="mcp-token">Auth token <span
                            class="text-ink-faint font-normal">(optional)</span></label>
                    <input class="field-input" id="mcp-token" type="password"
                        placeholder="Sent as a Bearer token, if your server needs one" />
                </div>
                <p id="mcp-error" class="text-[13px] text-[#c62b21] hidden"></p>
                <button type="submit" class="btn-secondary">Add MCP server</button>
            </form>
        </section>

        <section class="panel p-6">
            <h2 class="text-[15px] font-semibold text-ink mb-1" id="language-label">Language</h2>
            <p class="text-[13px] text-ink-soft mb-4">Use the switcher in the sidebar to change the interface and your
                Intelligence's language.</p>
        </section>
    </main>
    <script src="/js/settings-page.js"></script>
    <%- include('partials/footer') %>