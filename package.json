{
  "name": "makit",
  "version": "1.0.0",
  "description": "Makit — a background agent that watches a business's local market every day and tells the owner, in plain language, when customers have money to spend and what to do about it.",
  "main": "server.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --watch"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1131.0",
    "@google/genai": "^2.22.0",
    "@strands-agents/sdk": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "parallel-web": "^1.3.3",
    "rate-limit-redis": "^6.0.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  },
  "engines": {
    "node": ">=20"
  }
}
